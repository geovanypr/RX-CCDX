PORT=3002
# REQUERIDO: clave secreta larga y aleatoria. Nunca subir al repositorio.
JWT_SECRET=reemplazar_con_clave_secreta_larga_y_aleatoria
JWT_REFRESH_SECRET=reemplazar_con_otra_clave_secreta_diferente
# Orígenes permitidos separados por coma
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://geovanypr.github.io
# Bootstrap opcional de las cuentas iniciales. Defina estas variables en Render
# solo durante la primera puesta en marcha; las cuentas existentes no se modifican.
DEFAULT_SUPER_ADMIN_USERNAME=superadmin
DEFAULT_SUPER_ADMIN_PASSWORD=REEMPLAZAR_CON_CLAVE_LARGA
DEFAULT_ENCARGADA_USERNAME=encargada
DEFAULT_ENCARGADA_PASSWORD=REEMPLAZAR_CON_CLAVE_LARGA
DEFAULT_RADIOLOGO_USERNAME=radiologo
DEFAULT_RADIOLOGO_PASSWORD=REEMPLAZAR_CON_CLAVE_LARGA
DEFAULT_USER_SECURITY_ANSWER=REEMPLAZAR_CON_RESPUESTA_DE_SEGURIDAD
